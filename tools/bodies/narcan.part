            <a class="btn btn--outline" href="ways-to-give.html#monthly">Give monthly</a>
          </div>
        </div>
        <div>
          <div class="stats">
            <div class="stat">
              <p class="stat__figure">$45</p>
              <p class="stat__label">puts one two-dose Narcan kit in someone's hands</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

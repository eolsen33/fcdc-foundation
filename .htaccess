# Hostinger defaults every file to Cache-Control: public, max-age=604800 (7 days),
# so deploys never reach a browser that visited in the past week. Markup, styles
# and scripts must revalidate on each load; images and fonts stay long-cached and
# are versioned by filename when they change.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Baseline security headers (added by the 2026-09-21 weekly site check)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Caption tracks. Apache does not ship a mapping for .vtt, and a track served as
# text/plain is silently ignored by the browser — the captions button just never
# appears on the podcast video.
<IfModule mod_mime.c>
  AddType text/vtt .vtt
  AddType video/mp4 .mp4
  AddType video/webm .webm
</IfModule>

# seo-kit: crawler files must never sit in a CDN edge — they change with every deploy
<IfModule mod_headers.c>
  <FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
# /seo-kit

# Keep repo docs and tooling off the web (Hostinger deploys the whole repo).
# Added by the 2026-09-14 weekly site check: /README.md was publicly served.
RedirectMatch 404 ^/[^/]*\.md$
RedirectMatch 404 ^/(_build|_private|_pocketbase|tools|\.impeccable|\.git|\.github)(/|$)
RedirectMatch 404 ^/\.(gitignore|env|DS_Store)

# One address (2026-11-17 weekly site check): www. and the old staging host both
# answered 200 with the same pages. Send them to fcdcfoundation.org. The
# /.well-known/ path stays reachable on every host for certificate renewals.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^(www\.fcdcfoundation\.org|fcdc\.ericolsen\.studio)$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://fcdcfoundation.org%{REQUEST_URI} [R=301,L]
</IfModule>

# Hostinger defaults every file to Cache-Control: public, max-age=604800 (7 days),
# so deploys never reach a browser that visited in the past week. Markup, styles
# and scripts must revalidate on each load; images and fonts stay long-cached and
# are versioned by filename when they change.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Baseline security headers (added by the 2026-09-21 weekly site check)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Caption tracks. Apache does not ship a mapping for .vtt, and a track served as
# text/plain is silently ignored by the browser — the captions button just never
# appears on the podcast video.
<IfModule mod_mime.c>
  AddType text/vtt .vtt
  AddType video/mp4 .mp4
  AddType video/webm .webm
</IfModule>

# seo-kit: crawler files must never sit in a CDN edge — they change with every deploy
<IfModule mod_headers.c>
  <FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
# /seo-kit

# Keep repo docs and tooling off the web (Hostinger deploys the whole repo).
# Added by the 2026-09-14 weekly site check: /README.md was publicly served.
RedirectMatch 404 ^/[^/]*\.md$
RedirectMatch 404 ^/(_build|_private|_pocketbase|tools|brand|\.impeccable|\.git|\.github)(/|$)
RedirectMatch 404 ^/\.(gitignore|env|DS_Store)

# >>> Content-Security-Policy (OWASP header sweep 2026-11-24)
# Built from a browser crawl of every page plus a scan of the site's own files, then re-crawled
# to prove nothing is blocked. If you add a third-party script, font, embed, form target or API
# host to the site, ADD IT HERE TOO or browsers will silently block it.
# Tooling: /Volumes/External 1/DevStorage/audit-tools/csp/ (csp-probe.mjs verify ...)
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com https://formsubmit.co; frame-src https://www.facebook.com https://www.zeffy.com; object-src 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
# <<< Content-Security-Policy

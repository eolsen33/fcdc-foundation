# Hostinger defaults every file to Cache-Control: public, max-age=604800 (7 days),
# so deploys never reach a browser that visited in the past week. Markup, styles
# and scripts must revalidate on each load; images and fonts stay long-cached and
# are versioned by filename when they change.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Caption tracks. Apache does not ship a mapping for .vtt, and a track served as
# text/plain is silently ignored by the browser — the captions button just never
# appears on the podcast video.
<IfModule mod_mime.c>
  AddType text/vtt .vtt
  AddType video/mp4 .mp4
  AddType video/webm .webm
</IfModule>

# seo-kit: crawler files must never sit in a CDN edge — they change with every deploy
<IfModule mod_headers.c>
  <FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
# /seo-kit
